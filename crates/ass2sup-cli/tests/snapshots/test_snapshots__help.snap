---
source: crates/ass2sup-cli/tests/test_snapshots.rs
expression: stdout
---
CLI tool for converting ASS/SRT subtitles to SUP/PGS format

Usage: ass2sup [OPTIONS] [INPUT]...

Arguments:
  [INPUT]...
          Input subtitle file(s) (ASS/SSA/SRT)

Options:
      --glob <GLOB>
          Glob pattern for input files (alternative to positional args)

      --recursive
          Traverse subdirectories when using --glob

      --max-files <MAX_FILES>
          Limit number of files processed when using --glob

  -o, --output <OUTPUT>
          Output SUP file path (single file mode)

  -d, --output-dir <OUTPUT_DIR>
          Output directory (batch mode)

  -r, --resolution <RESOLUTION>
          Display resolution (WIDTHxHEIGHT).
          
          If not specified, uses PlayResX/PlayResY from [Script Info] section. Falls back to 1920×1080 if Script Info resolution is missing or zero.

  -f, --fps <FPS>
          Frames per second
          
          [default: 23.976]

      --validate
          Run validation before conversion

      --overlap <OVERLAP>
          Overlap detection mode (off/strict/lenient); enables detection
          
          [default: off]
          [possible values: off, strict, lenient]

      --max-colors <MAX_COLORS>
          Maximum colors in palette (1–255)
          
          [default: 255]

      --dither <DITHER>
          Dithering method (none/floyd-steinberg/ordered)
          
          [default: floyd-steinberg]
          [possible values: none, floyd-steinberg, ordered]

      --font <FONT>
          Default font name for SRT input
          
          [default: Arial]

      --font-size <FONT_SIZE>
          Default font size for SRT input (native backend only)
          
          [default: 48.0]

      --font-map <STYLE:FALLBACKS>
          Per-style font fallback map (native backend only). Each entry is "StyleName:fallback1,fallback2". Can be repeated multiple times

      --font-dir <DIR>
          Additional directories to scan for font files (TTF/OTF/WOFF2)

      --no-check-fonts
          Skip font availability check (native backend only)

  -p, --parallel
          Process files in parallel (batch mode)

      --color-space <COLOR_SPACE>
          Output colour space (srgb/bt709/bt2020, native backend only)
          
          [default: srgb]
          [possible values: srgb, bt709, bt2020]

      --tonemap <TONEMAP>
          HDR-to-SDR tone mapping operator (hable/reinhard/aces, native backend only)
          
          [possible values: hable, reinhard, aces]

      --compat-vsfilter
          Enable VSFilter compatibility mode (native backend only, experimental).
          
          Compensates for font advance-width differences between swash and GDI/VSFilter by scaling font_size by ~0.764×, matching easyavs2bdnxml output dimensions more closely. This is an approximation — exact results depend on the specific font.

      --backend <BACKEND>
          Render backend to use (native, libass).  Only available when both backends are compiled in (--features native-backend,libass-backend)
          
          [default: native]

      --format <FORMAT>
          Output format (sup/srt/bdn)
          
          [default: sup]
          [possible values: sup, srt, bdn]

      --check
          Parse and validate only, don't convert (exit 0 if OK, 1 if errors)

      --force
          Force conversion even if validation fails

      --log-level <LOG_LEVEL>
          Log level (error/warn/info/debug/trace)
          
          [default: info]
          [possible values: error, warn, info, debug, trace]

      --quiet
          Suppress progress bar

      --color <COLOR>
          Colour output mode (auto/always/never)
          
          [default: auto]
          [possible values: auto, always, never]

      --log-file <PATH>
          Write diagnostic logs (with timestamps) to this file in addition to stderr

  -h, --help
          Print help (see a summary with '-h')

  -V, --version
          Print version
